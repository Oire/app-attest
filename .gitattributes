# Normalize line endings to LF everywhere
* text=auto eol=lf

# Golden vectors stay byte-for-byte as the references ship them
tests/fixtures/** binary
# ...except the sidecars and notes written for this repository
tests/fixtures/*/*.json text eol=lf diff merge
tests/fixtures/README.md text eol=lf diff merge

# https://php.watch/articles/composer-gitattributes
# Exclude development files from the Composer archive.
# resources/ is NOT excluded: it holds the Apple root certificate read at run time.
/.github                export-ignore
/docs                   export-ignore
/tests                  export-ignore
/.editorconfig          export-ignore
/.gitattributes         export-ignore
/.gitignore             export-ignore
/.php-cs-fixer.dist.php export-ignore
/CLAUDE.md              export-ignore
/compose.yaml           export-ignore
/Dockerfile             export-ignore
/phpunit.xml.dist       export-ignore
/psalm.xml.dist         export-ignore

# Configure diff output for .php files
*.php diff=php
